{
  "name": "arch-lab",
  "version": "1.0.0",
  "description": "Laboratório prático de referência e excelência em Arquitetura de Software e Engenharia de Sistemas Corporativos",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "vitest run lab/00-fitness-functions",
    "test:unit": "vitest run --exclude '**/lab/00-fitness-functions/**'",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "software-architecture",
    "clean-architecture",
    "hexagonal-architecture",
    "domain-driven-design",
    "cqrs",
    "event-sourcing",
    "transactional-outbox",
    "saga-pattern",
    "resilience",
    "fitness-functions"
  ],
  "author": "arch-lab team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
